{
	on_demand_tls {
		ask http://127.0.0.1:3000/api/internal/domains/authorize
	}
}

# Customer domains terminate here. The ask endpoint prevents arbitrary hosts
# from consuming certificates and keeps routing bound to active website records.
https:// {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:3000
}
