{
	email matrouhsolutions@gmail.com
	servers {
		protocols h1 h2
	}
	on_demand_tls {
		ask http://127.0.0.1:3000/api/internal/domains/authorize
	}
}

(http_redirect) {
	# Cloudflare Flexible reaches the origin over HTTP while the visitor is already on
	# HTTPS. Serving that request avoids an HTTPS-to-HTTPS redirect loop. Direct HTTP
	# visitors still receive the canonical redirect below.
	@cloudflare_https header X-Forwarded-Proto https
	handle @cloudflare_https {
		reverse_proxy 127.0.0.1:3000
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

http:// {
	import http_redirect
}

mportfolio.ink, www.mportfolio.ink {
	tls /etc/caddy/certs/mportfolio-origin.crt /etc/caddy/certs/mportfolio-origin.key
	@renderer_gateway header X-Factory-Site-Host *
	handle @renderer_gateway {
		reverse_proxy 127.0.0.1:3001
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

auth.mportfolio.ink {
	tls /etc/caddy/certs/mportfolio-origin.crt /etc/caddy/certs/mportfolio-origin.key
	reverse_proxy 127.0.0.1:8080
}

media.mportfolio.ink {
	tls /etc/caddy/certs/mportfolio-origin.crt /etc/caddy/certs/mportfolio-origin.key
	reverse_proxy 127.0.0.1:3003
}

renderer.mportfolio.ink {
	tls /etc/caddy/certs/mportfolio-origin.crt /etc/caddy/certs/mportfolio-origin.key
	reverse_proxy 127.0.0.1:3001
}

*.mportfolio.ink {
	tls /etc/caddy/certs/mportfolio-origin.crt /etc/caddy/certs/mportfolio-origin.key
	reverse_proxy 127.0.0.1:3000
}

# Customer domains terminate here. Caddy asks the dashboard before issuing a
# certificate, and the dashboard approves only an active route on a published site.
https:// {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:3000
}
