{
  "manifestFormatVersion": 1,
  "manifest": {
    "id": "com.matrouh.creative",
    "version": "1.0.1",
    "displayName": "Studio Folio",
    "author": "Matrouh Solutions",
    "description": "Editorial portfolio for designers, creative directors, photographers, and independent studios",
    "category": "portfolio",
    "features": [
      "localized-content",
      "editorial-hero",
      "portrait-media",
      "case-studies",
      "services",
      "creative-process",
      "testimonials",
      "semantic-theme",
      "seo",
      "contact-page"
    ]
  },
  "compatibility": {
    "sdkVersion": "1.0.0",
    "minimumFactoryVersion": "0.1.0",
    "minimumRendererVersion": "0.1.0",
    "contentSchemaVersion": 1,
    "themeSchemaVersion": 1,
    "publicationSnapshotVersion": 1
  },
  "websiteSchema": {
    "formatVersion": 1,
    "typeName": "ZodObject",
    "description": "Creative studio identity and contact settings.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "email": {
          "default": "hello@studio.example",
          "type": "string",
          "maxLength": 320,
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "phone": {
          "default": "+20 100 000 0000",
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        },
        "location": {
          "default": "Cairo, Egypt / Available worldwide",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "enquiryPath": {
          "default": "/contact",
          "type": "string",
          "pattern": "^\\/(?:[a-z0-9/_-]*)$"
        },
        "colorMode": {
          "default": "light",
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        },
        "logoMediaId": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "schemaHash": "ed62c061a2360f37bb02b52f6067371d",
    "fields": {
      "/email": {
        "label": "Email",
        "control": "text",
        "order": 1,
        "sensitive": true
      },
      "/phone": {
        "label": "Phone",
        "control": "text",
        "order": 2
      },
      "/location": {
        "label": "Location",
        "control": "text",
        "order": 3,
        "localization": "value"
      },
      "/enquiryPath": {
        "label": "Enquiry path",
        "control": "url",
        "order": 4
      },
      "/colorMode": {
        "label": "Template appearance",
        "control": "select",
        "order": 5,
        "options": [
          {
            "label": "Light",
            "value": "light"
          },
          {
            "label": "Dark",
            "value": "dark"
          }
        ]
      },
      "/logoMediaId": {
        "label": "Custom logo",
        "control": "media",
        "order": 6,
        "mediaKinds": [
          "image"
        ]
      }
    }
  },
