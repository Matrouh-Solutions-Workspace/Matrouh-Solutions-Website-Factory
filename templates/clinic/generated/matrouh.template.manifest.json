  "websiteSchema": {
    "formatVersion": 1,
    "typeName": "ZodObject",
    "description": "Public clinic contact settings.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "centralPhone": {
          "default": "+20 100 000 0000",
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        },
        "centralEmail": {
          "default": "clinic@example.com",
          "type": "string",
          "maxLength": 320,
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "bookingPath": {
          "default": "/book",
          "type": "string",
          "pattern": "^\\/(?:[a-z0-9/_-]*)$"
        },
        "emergencyNotice": {
          "default": "",
          "type": "string",
          "maxLength": 300
        }
      },
      "additionalProperties": false
    },
    "schemaHash": "aa9f969233e7aa8ec11d80a46a6bc34c",
    "fields": {
      "/centralPhone": {
        "label": "Central phone",
        "control": "text",
        "order": 1
      },
      "/centralEmail": {
        "label": "Central email",
        "control": "text",
        "order": 2,
        "sensitive": true
      },
      "/bookingPath": {
        "label": "Booking path",
        "control": "url",
        "order": 3
      },
      "/emergencyNotice": {
        "label": "Emergency notice",
        "control": "textarea",
        "order": 4,
        "localization": "value"
      }
    }
  },
