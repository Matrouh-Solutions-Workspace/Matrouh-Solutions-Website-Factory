  ],
  "pages": [
    {
      "id": "com.matrouh.clinic/page/home",
      "title": "Home",
      "slug": {
        "kind": "fixed",
        "defaultValue": "/",
        "maximumLength": 1
      },
      "allowedSections": [
        "com.matrouh.clinic/section/hero",
