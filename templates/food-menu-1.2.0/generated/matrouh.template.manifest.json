{
  "manifestFormatVersion": 1,
  "manifest": {
    "id": "com.matrouh.food-menu",
    "version": "1.2.0",
    "displayName": "Saffron — Food & Café Menu",
    "author": "Matrouh Solutions",
    "description": "A mobile-first bilingual digital menu for restaurants, cafés, bakeries, and food businesses",
    "category": "food-and-hospitality",
    "previewImage": "/templates/food-menu/food-cafe-hero.jpg",
    "features": [
      "digital-menu",
      "menu-management",
      "nested-categories",
      "item-variants",
      "localized-content",
      "item-media",
      "pdf-import-review",
      "mobile-first",
      "qr-ready",
      "claim-ready",
      "semantic-theme",
      "seo"
    ]
  },
  "compatibility": {
    "sdkVersion": "1.0.0",
    "minimumFactoryVersion": "0.1.0",
    "minimumRendererVersion": "0.1.0",
    "contentSchemaVersion": 1,
    "themeSchemaVersion": 1,
    "publicationSnapshotVersion": 1
  },
  "websiteSchema": {
    "formatVersion": 1,
    "typeName": "ZodObject",
    "description": "Restaurant identity, language, currency, and menu display settings.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "logoMediaId": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "colorMode": {
          "default": "light",
          "type": "string",
          "const": "light"
        },
        "allowAppearanceToggle": {
          "default": false,
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": false
    },
    "schemaHash": "2cc5c804d9b35aa3c77e6d9e888daf25",
    "fields": {
      "/logoMediaId": {
        "label": "Business logo",
        "control": "media",
        "order": 1,
        "mediaKinds": [
          "image"
        ]
      },
      "/colorMode": {
        "label": "Appearance",
        "control": "text",
        "order": 2,
        "readOnlyWhen": {
          "path": "/colorMode",
          "operator": "present"
        }
      },
      "/allowAppearanceToggle": {
        "label": "Allow dark mode",
        "control": "boolean",
        "order": 3,
        "readOnlyWhen": {
          "path": "/allowAppearanceToggle",
          "operator": "present"
        }
      }
    }
  },
  "capabilities": [],
  "routes": [
    {
      "id": "com.matrouh.food-menu/route/menu",
      "pattern": "/:slug?",
      "priority": 10,
      "pageTypes": [
        "com.matrouh.food-menu/page/menu"
      ],
      "localePolicy": "prefix-except-default",
      "indexingPolicy": "inherit-page"
    }
  ],
  "pages": [
    {
      "id": "com.matrouh.food-menu/page/menu",
      "title": "Menu",
      "slug": {
        "kind": "fixed",
        "defaultValue": "/",
        "maximumLength": 1
      },
      "allowedSections": [
        "com.matrouh.food-menu/section/identity",
        "com.matrouh.food-menu/section/catalog",
        "com.matrouh.food-menu/section/visit",
        "com.matrouh.food-menu/section/import-review"
