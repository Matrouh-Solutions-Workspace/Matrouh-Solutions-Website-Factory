        {
          "sectionTypeId": "com.matrouh.food-menu/section/catalog",
          "minimum": 1,
          "maximum": 1
        },
        {
          "sectionTypeId": "com.matrouh.food-menu/section/visit",
          "minimum": 1,
          "maximum": 1
        },
        {
