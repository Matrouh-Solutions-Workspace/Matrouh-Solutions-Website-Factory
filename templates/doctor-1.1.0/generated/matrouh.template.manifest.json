{
  "manifestFormatVersion": 1,
  "manifest": {
    "id": "com.matrouh.doctor",
    "version": "1.1.0",
    "displayName": "Doctor Practice",
    "author": "Matrouh Solutions",
    "description": "Calm, trustworthy personal medical practice template",
    "category": "healthcare",
    "features": [
      "localized-content",
      "semantic-theme",
      "seo",
      "contact-page"
    ]
  },
  "compatibility": {
    "sdkVersion": "1.0.0",
    "minimumFactoryVersion": "0.1.0",
    "minimumRendererVersion": "0.1.0",
    "contentSchemaVersion": 1,
    "themeSchemaVersion": 1,
    "publicationSnapshotVersion": 1
  },
  "websiteSchema": {
    "formatVersion": 1,
    "typeName": "ZodObject",
    "description": "Public practice contact settings.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "phone": {
          "default": "+20 100 000 0000",
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        },
        "email": {
          "default": "doctor@example.com",
          "type": "string",
          "maxLength": 320,
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "address": {
          "default": "Matrouh, Egypt",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "appointmentPath": {
          "default": "/contact",
          "type": "string",
          "pattern": "^\\/(?:[a-z0-9/_-]*)$"
        }
      },
      "additionalProperties": false
    },
    "schemaHash": "f2ff11c35bc490f58feebb01eac6a540",
    "fields": {
      "/phone": {
        "label": "Phone",
        "control": "text",
        "order": 1
      },
      "/email": {
        "label": "Email",
        "control": "text",
        "order": 2,
        "sensitive": true
      },
      "/address": {
        "label": "Address",
        "control": "textarea",
        "order": 3,
        "localization": "value"
      },
      "/appointmentPath": {
        "label": "Appointment path",
        "control": "url",
        "order": 4
      }
    }
  },
  "capabilities": [],
  "routes": [
    {
      "id": "com.matrouh.doctor/route/page",
      "pattern": "/:slug?",
      "priority": 0,
      "pageTypes": [
        "com.matrouh.doctor/page/home",
        "com.matrouh.doctor/page/contact"
      ],
      "localePolicy": "prefix-except-default",
      "indexingPolicy": "inherit-page"
    }
  ],
  "pages": [
    {
      "id": "com.matrouh.doctor/page/home",
      "title": "Home",
      "slug": {
        "kind": "fixed",
        "defaultValue": "/",
        "maximumLength": 1
      },
      "allowedSections": [
        "com.matrouh.doctor/section/hero",
        "com.matrouh.doctor/section/services"
      ],
      "requiredSections": [
        {
          "sectionTypeId": "com.matrouh.doctor/section/hero",
          "minimum": 1,
          "maximum": 1
        },
        {
          "sectionTypeId": "com.matrouh.doctor/section/services",
          "minimum": 0,
          "maximum": 1
        }
      ],
      "defaultSections": [
        {
          "sectionTypeId": "com.matrouh.doctor/section/hero"
        },
        {
          "sectionTypeId": "com.matrouh.doctor/section/services"
        }
      ],
      "supportsSEO": true,
      "supportsNavigation": true,
      "supportsIndexing": true,
      "editor": {
        "description": "Primary practice landing page",
        "icon": "home"
      }
    },
    {
      "id": "com.matrouh.doctor/page/contact",
      "title": "Contact",
      "slug": {
        "kind": "fixed",
        "defaultValue": "contact",
        "maximumLength": 80
      },
      "allowedSections": [
        "com.matrouh.doctor/section/contact"
      ],
      "requiredSections": [
        {
          "sectionTypeId": "com.matrouh.doctor/section/contact",
          "minimum": 1,
          "maximum": 1
        }
      ],
      "defaultSections": [
        {
          "sectionTypeId": "com.matrouh.doctor/section/contact"
        }
      ],
      "supportsSEO": true,
      "supportsNavigation": true,
      "supportsIndexing": true,
      "editor": {
        "description": "Contact and appointment information",
        "icon": "phone"
      }
