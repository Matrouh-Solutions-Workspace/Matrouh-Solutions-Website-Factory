  "components": [
    {
      "id": "com.matrouh.menu-qr/section/menu",
      "kind": "section",
      "title": "Uploaded menu",
      "description": "One clean page for a PDF or photo menu.",
      "category": "content",
      "schema": {
        "formatVersion": 1,
        "typeName": "ZodObject",
        "description": "Upload a single menu PDF or image for customers to view.",
        "jsonSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "menu": {
              "default": {
                "mediaId": null,
                "mediaKind": null,
                "filename": ""
              },
              "type": "object",
              "properties": {
                "mediaId": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "mediaKind": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "image",
                        "document"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "filename": {
                  "default": "",
                  "type": "string",
                  "maxLength": 255
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "schemaHash": "7e0760b8cd1aeff0e58db88975f85c61",
        "fields": {
          "/menu": {
            "label": "Menu PDF or photo",
            "control": "menu-upload",
            "order": 1
          }
        }
      },
      "composedOf": [],
      "capabilities": []
    }
  ],
