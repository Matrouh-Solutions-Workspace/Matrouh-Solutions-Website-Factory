DATABASE_URL="postgresql://factory:factory@localhost:5432/factory"
FACTORY_DEPLOYMENT_MODE="local"
# Leave blank locally to reuse DATABASE_URL. Production must provision a separate
# login mapped to the read-only factory_renderer role.
DATABASE_RENDERER_URL=""
FACTORY_BASE_DOMAIN="localhost"
FACTORY_DASHBOARD_PUBLIC_URL="http://localhost:3000"
FACTORY_RENDERER_PUBLIC_URL="http://localhost:3001"
FACTORY_RENDERER_INTERNAL_URL="http://127.0.0.1:3001"
FACTORY_ARTIFACT_DRIVER="local"
FACTORY_ARTIFACT_DIRECTORY="./artifacts"
FACTORY_S3_BUCKET=""
FACTORY_S3_REGION="us-east-1"
FACTORY_S3_ENDPOINT=""
FACTORY_S3_PREFIX="factory"
FACTORY_S3_FORCE_PATH_STYLE="false"
FACTORY_TEMPLATE_DIRECTORY="./templates"
PREVIEW_SIGNING_SECRET="replace-with-at-least-32-characters"
FACTORY_AUTH_MODE="demo"
# Required when FACTORY_AUTH_MODE=oidc (and for every production deployment).
FACTORY_OIDC_ISSUER="https://identity.example.com"
FACTORY_OIDC_CLIENT_ID="website-factory"
FACTORY_OIDC_CLIENT_SECRET="replace-with-provider-secret"
FACTORY_OIDC_REDIRECT_URI="http://localhost:3000/api/auth/callback"
FACTORY_CACHE_INVALIDATION_URL="http://localhost:3001/api/internal/cache/invalidate"
FACTORY_CACHE_INVALIDATION_SECRET="replace-with-an-independent-32-character-secret"
FACTORY_DOMAIN_CHALLENGE_SECRET="replace-with-an-independent-domain-challenge-secret"
FACTORY_DOMAIN_PROVIDER_URL="http://localhost:3010/v1/domains/connect"
FACTORY_DOMAIN_PROVIDER_SECRET="replace-with-an-independent-provider-webhook-secret"
FACTORY_MEDIA_PROVIDER_URL="http://localhost:3011/v1/media"
FACTORY_MEDIA_PROVIDER_SECRET="replace-with-an-independent-media-provider-secret"
FACTORY_MEDIA_PUBLIC_BASE_URL="https://media.example.com"
FACTORY_MAIL_PROVIDER_URL="http://localhost:3012/v1/mail/send"
FACTORY_MAIL_PROVIDER_SECRET="replace-with-an-independent-mail-provider-secret"
FACTORY_MAIL_FROM="support@matrouh.solutions"
FACTORY_MAX_UPLOAD_BYTES="5000000"
FACTORY_MAX_ORGANIZATION_MEDIA_BYTES="1000000000"
FACTORY_STANDARD_AUDIT_RETENTION_DAYS="365"
FACTORY_SECURITY_AUDIT_RETENTION_DAYS="730"
FACTORY_METRICS_SECRET="replace-with-at-least-32-characters"
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3000"
