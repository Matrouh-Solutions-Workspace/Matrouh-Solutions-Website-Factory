{
  "name": "@factory/template-sdk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "import": "./dist/version.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/version.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.1.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.1.9"
  }
}
