generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  active
  suspended
  archived
  deletion_pending
}

enum WebsiteStatus {
  draft
  published
  unpublished
  disabled
  archived
}

enum SubscriptionCadence {
  trial
  monthly
  yearly
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

enum OutboundMessageStatus {
  queued
  delivering
  sent
  failed
}

enum PublicationStatus {
  compiling
  validating
  ready
  failed
  retired
}

enum DomainStatus {
  pending
  verifying
  verified
  connecting
  active
  failed
  disconnected
}

enum MediaStatus {
  pending_upload
  quarantined
  scanning
  processing
  ready
  rejected
  deleted
}

enum JobStatus {
  queued
  running
  retryable
  succeeded
  failed
  dead_letter
}

enum DeliveryStatus {
  pending
  delivering
  published
  failed
}

model Organization {
  id                  String                @id @db.Uuid
  slug                String                @db.VarChar(80)
  name                String                @db.VarChar(200)
  status              OrganizationStatus    @default(active)
  defaultLocale       String                @map("default_locale") @db.VarChar(35)
  planKey             String                @map("plan_key") @db.VarChar(80)
  revision            BigInt                @default(1)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt          DateTime?             @map("archived_at") @db.Timestamptz
  memberships         Membership[]
  clients             Client[]
  websites            Website[]
  subscriptions       WebsiteSubscription[]
  outboundMessages    OutboundMessage[]
  websiteClaims       WebsiteClaim[]
  passwordResets      PasswordReset[]
  roles               Role[]
  pluginInstallations PluginInstallation[]
  hostingDomains     HostingDomain[]

  @@map("organizations")
}

model User {
  id              String         @id @db.Uuid
  displayName     String         @map("display_name") @db.VarChar(200)
  primaryEmail    String         @map("primary_email") @db.VarChar(320)
  normalizedEmail String         @unique @map("normalized_email") @db.VarChar(320)
  passwordHash    String?        @map("password_hash") @db.VarChar(255)
  status          String         @db.VarChar(24)
  revision        BigInt         @default(1)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  identities      AuthIdentity[]
  memberships     Membership[]
  sessions        Session[]
  passwordResets  PasswordReset[]
  claimedWebsites WebsiteClaim[] @relation("ClaimedWebsiteOwner")

  @@map("users")
}

model AuthIdentity {
  id              String   @id @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  providerKey     String   @map("provider_key") @db.VarChar(80)
  providerSubject String   @map("provider_subject") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([providerKey, providerSubject])
  @@map("auth_identities")
}

model Session {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model PasswordReset {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  tokenHash      String       @unique @map("token_hash") @db.VarChar(128)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz
  usedAt         DateTime?    @map("used_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([userId, expiresAt])
  @@map("password_resets")
}

model Membership {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String?          @map("user_id") @db.Uuid
  status         String           @db.VarChar(24)
  invitedEmail   String?          @map("invited_email") @db.VarChar(320)
  revision       BigInt           @default(1)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User?            @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles          MembershipRole[]

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@map("memberships")
}

model Role {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  key            String           @db.VarChar(80)
  name           String           @db.VarChar(120)
  isSystem       Boolean          @default(false) @map("is_system")
  revision       BigInt           @default(1)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships    MembershipRole[]
  permissions    RolePermission[]

  @@unique([organizationId, id])
  @@unique([organizationId, key])
  @@map("roles")
}

model Permission {
  id          String           @id @db.Uuid
  key         String           @unique @db.VarChar(120)
  description String           @db.VarChar(300)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  organizationId String     @map("organization_id") @db.Uuid
  roleId         String     @map("role_id") @db.Uuid
  permissionId   String     @map("permission_id") @db.Uuid
  role           Role       @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)
  permission     Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  organizationId String     @map("organization_id") @db.Uuid
  membershipId   String     @map("membership_id") @db.Uuid
  roleId         String     @map("role_id") @db.Uuid
  membership     Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)
  role           Role       @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model Client {
  id               String                @id @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  name             String                @db.VarChar(200)
  contactName      String?               @map("contact_name") @db.VarChar(200)
  contactEmail     String?               @map("contact_email") @db.VarChar(320)
  contactPhone     String?               @map("contact_phone") @db.VarChar(50)
  notes            String?               @db.Text
  revision         BigInt                @default(1)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt       DateTime?             @map("archived_at") @db.Timestamptz
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  websites         Website[]
  subscriptions    WebsiteSubscription[]
  outboundMessages OutboundMessage[]

  @@unique([organizationId, id])
  @@index([organizationId, archivedAt, name])
  @@map("clients")
}

model Website {
  id                  String                 @id @db.Uuid
  organizationId      String                 @map("organization_id") @db.Uuid
  clientId            String?                @map("client_id") @db.Uuid
  name                String                 @db.VarChar(200)
  status              WebsiteStatus          @default(draft)
  templateId          String                 @map("template_id") @db.VarChar(160)
  templateVersion     String                 @map("template_version") @db.VarChar(64)
  defaultLocale       String                 @map("default_locale") @db.VarChar(35)
  faviconAssetId      String?                @map("favicon_asset_id") @db.Uuid
  whiteLabelEnabled   Boolean                @default(false) @map("white_label_enabled")
  draftRevision       BigInt                 @default(1) @map("draft_revision")
  activePublicationId String?                @map("active_publication_id") @db.Uuid
  revision            BigInt                 @default(1)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt          DateTime?              @map("archived_at") @db.Timestamptz
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client              Client?                @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict)
  faviconAsset        MediaAsset?            @relation("WebsiteFavicon", fields: [organizationId, faviconAssetId], references: [organizationId, id], onDelete: Restrict)
  locales             WebsiteLocale[]
  settingsDrafts      WebsiteSettingsDraft[]
  pages               PageDraft[]
  navigationDrafts    NavigationDraft[]
  themeDrafts         ThemeDraft[]
  seoDrafts           SeoDraft[]
  domains             Domain[]
  publications        Publication[]          @relation("WebsitePublications")
  previewSnapshots    PreviewSnapshot[]
  subscription        WebsiteSubscription?
  outboundMessages    OutboundMessage[]
  claims              WebsiteClaim[]
  activePublication   Publication?           @relation("ActivePublication", fields: [organizationId, id, activePublicationId], references: [organizationId, websiteId, id])

  @@unique([organizationId, id])
  @@unique([organizationId, id, activePublicationId])
  @@index([organizationId, status, updatedAt])
  @@map("websites")
}

model WebsiteSubscription {
  id             String              @id @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  websiteId      String              @unique @map("website_id") @db.Uuid
  clientId       String?             @map("client_id") @db.Uuid
  cadence        SubscriptionCadence
  status         SubscriptionStatus  @default(active)
  startsAt       DateTime            @map("starts_at") @db.Timestamptz
  expiresAt      DateTime            @map("expires_at") @db.Timestamptz
  lastNotifiedAt DateTime?           @map("last_notified_at") @db.Timestamptz
  disabledAt     DateTime?           @map("disabled_at") @db.Timestamptz
  disabledReason String?             @map("disabled_reason") @db.VarChar(80)
  resumeStatus   WebsiteStatus?      @map("resume_status")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  website        Website             @relation(fields: [organizationId, websiteId], references: [organizationId, id], onDelete: Restrict)
  client         Client?             @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, websiteId])
  @@index([organizationId, status, expiresAt])
  @@map("website_subscriptions")
}

model WebsiteClaim {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  websiteId       String    @map("website_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash") @db.VarChar(128)
  intendedEmail   String?   @map("intended_email") @db.VarChar(320)
  status          String    @default("pending") @db.VarChar(24)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  claimedByUserId String?   @map("claimed_by_user_id") @db.Uuid
  claimedAt       DateTime? @map("claimed_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  website         Website   @relation(fields: [organizationId, websiteId], references: [organizationId, id], onDelete: Restrict)
  claimedByUser   User?     @relation("ClaimedWebsiteOwner", fields: [claimedByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, websiteId, status])
  @@map("website_claims")
}

model OutboundMessage {
  id             String                @id @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  websiteId      String?               @map("website_id") @db.Uuid
  clientId       String?               @map("client_id") @db.Uuid
  recipientEmail String                @map("recipient_email") @db.VarChar(320)
  subject        String                @db.VarChar(240)
  bodyText       String                @map("body_text") @db.Text
  kind           String                @db.VarChar(80)
  status         OutboundMessageStatus @default(queued)
  scheduledFor   DateTime              @default(now()) @map("scheduled_for") @db.Timestamptz
  availableAt    DateTime              @default(now()) @map("available_at") @db.Timestamptz
  attemptCount   Int                   @default(0) @map("attempt_count")
  maxAttempts    Int                   @default(5) @map("max_attempts")
  sentAt         DateTime?             @map("sent_at") @db.Timestamptz
  failureReason  String?               @map("failure_reason") @db.Text
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  website        Website?              @relation(fields: [organizationId, websiteId], references: [organizationId, id], onDelete: Restrict)
  client         Client?               @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict)

  @@unique([websiteId, kind])
  @@index([organizationId, status, availableAt])
  @@index([websiteId, createdAt])
  @@map("outbound_messages")
}

model WebsiteLocale {
  organizationId String   @map("organization_id") @db.Uuid
  websiteId      String   @map("website_id") @db.Uuid
  locale         String   @db.VarChar(35)
  isDefault      Boolean  @default(false) @map("is_default")
  fallbackLocale String?  @map("fallback_locale") @db.VarChar(35)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  website        Website  @relation(fields: [organizationId, websiteId], references: [organizationId, id], onDelete: Restrict)

  @@id([websiteId, locale])
  @@map("website_locales")
}

model WebsiteSettingsDraft {
  id               String   @id @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  websiteId        String   @map("website_id") @db.Uuid
  locale           String?  @db.VarChar(35)
  schemaVersion    Int      @map("schema_version")
  contentJson      Json     @map("content_json") @db.JsonB
  contentSizeBytes Int      @map("content_size_bytes")
  revision         BigInt   @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz
  website          Website  @relation(fields: [organizationId, websiteId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, websiteId, id])
  @@index([organizationId, websiteId, locale])
  @@map("website_settings_drafts")
}

model PageDraft {
  id             String         @id @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  websiteId      String         @map("website_id") @db.Uuid
  pageTypeId     String         @map("page_type_id") @db.VarChar(160)
  locale         String         @db.VarChar(35)
  title          String         @db.VarChar(200)
  slug           String         @db.VarChar(240)
  status         String         @default("active") @db.VarChar(24)
  schemaVersion  Int            @default(1) @map("schema_version")
  settingsJson   Json           @default("{}") @map("settings_json") @db.JsonB
  orderKey       String         @map("order_key") @db.VarChar(128)
  revision       BigInt         @default(1)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz
  website        Website        @relation(fields: [organizationId, websiteId], references: [organizationId, id], onDelete: Restrict)
  sections       SectionDraft[]
  seoDrafts      SeoDraft[]

  @@unique([organizationId, websiteId, id])
  @@unique([organizationId, id])
  @@index([websiteId, locale, orderKey])
  @@map("page_drafts")
}

model SectionDraft {
  id               String           @id @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  websiteId        String           @map("website_id") @db.Uuid
  pageId           String           @map("page_id") @db.Uuid
  sectionTypeId    String           @map("section_type_id") @db.VarChar(160)
  schemaVersion    Int              @map("schema_version")
  contentJson      Json             @map("content_json") @db.JsonB
  contentSizeBytes Int              @default(0) @map("content_size_bytes")
  visibilityJson   Json             @default("{}") @map("visibility_json") @db.JsonB
  orderKey         String           @map("order_key") @db.VarChar(128)
  revision         BigInt           @default(1)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz
  page             PageDraft        @relation(fields: [organizationId, websiteId, pageId], references: [organizationId, websiteId, id], onDelete: Restrict)
  mediaReferences  MediaReference[]

  @@unique([organizationId, id])
  @@index([pageId, orderKey])
  @@map("section_drafts")
}

model NavigationDraft {
  id                      String                @id @db.Uuid
  organizationId          String                @map("organization_id") @db.Uuid
  websiteId               String                @map("website_id") @db.Uuid
  definitionId            String                @map("definition_id") @db.VarChar(160)
  locale                  String?               @db.VarChar(35)
  visibilitySchemaVersion Int                   @map("visibility_schema_version")
  revision                BigInt                @default(1)
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt               DateTime?             @map("deleted_at") @db.Timestamptz
  website                 Website               @relation(fields: [organizationId, websiteId], references: [organizationId, id], onDelete: Restrict)
  nodes                   NavigationNodeDraft[]

  @@unique([organizationId, websiteId, id])
  @@unique([organizationId, websiteId, definitionId, locale])
  @@index([websiteId, definitionId])
  @@map("navigation_drafts")
}

model NavigationNodeDraft {
  id             String                @id @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  websiteId      String                @map("website_id") @db.Uuid
  navigationId   String                @map("navigation_id") @db.Uuid
  parentNodeId   String?               @map("parent_node_id") @db.Uuid
  nodeKind       String                @map("node_kind") @db.VarChar(24)
  pageId         String?               @map("page_id") @db.Uuid
  labelJson      Json                  @map("label_json") @db.JsonB
  targetJson     Json                  @map("target_json") @db.JsonB
  visibilityJson Json                  @map("visibility_json") @db.JsonB
  orderKey       String                @map("order_key") @db.VarChar(128)
  revision       BigInt                @default(1)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?             @map("deleted_at") @db.Timestamptz
  navigation     NavigationDraft       @relation(fields: [organizationId, websiteId, navigationId], references: [organizationId, websiteId, id], onDelete: Restrict)
  parent         NavigationNodeDraft?  @relation("NavigationNodeTree", fields: [organizationId, websiteId, navigationId, parentNodeId], references: [organizationId, websiteId, navigationId, id], onDelete: Restrict, map: "navigation_node_drafts_tenant_parent_fkey")
  children       NavigationNodeDraft[] @relation("NavigationNodeTree")

  @@unique([organizationId, websiteId, id])
  @@unique([organizationId, websiteId, navigationId, id])
  @@index([navigationId, parentNodeId, orderKey])
  @@map("navigation_node_drafts")
}

model ThemeDraft {
  id                String    @id @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  websiteId         String    @map("website_id") @db.Uuid
  locale            String?   @db.VarChar(35)
  themeDefinitionId String    @map("theme_definition_id") @db.VarChar(160)
  schemaVersion     Int       @map("schema_version")
  tokensJson        Json      @map("tokens_json") @db.JsonB
  contentSizeBytes  Int       @default(0) @map("content_size_bytes")
  revision          BigInt    @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz
  website           Website   @relation(fields: [organizationId, websiteId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, websiteId, id])
  @@index([organizationId, websiteId, locale])
  @@map("theme_drafts")
}

model SeoDraft {
  id               String     @id @db.Uuid
  organizationId   String     @map("organization_id") @db.Uuid
  websiteId        String     @map("website_id") @db.Uuid
  pageId           String?    @map("page_id") @db.Uuid
  locale           String?    @db.VarChar(35)
  schemaVersion    Int        @map("schema_version")
  metadataJson     Json       @map("metadata_json") @db.JsonB
  contentSizeBytes Int        @default(0) @map("content_size_bytes")
  revision         BigInt     @default(1)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz
  website          Website    @relation(fields: [organizationId, websiteId], references: [organizationId, id], onDelete: Restrict)
  page             PageDraft? @relation(fields: [organizationId, websiteId, pageId], references: [organizationId, websiteId, id], onDelete: Restrict)

  @@unique([organizationId, websiteId, id])
  @@unique([organizationId, websiteId, pageId, locale])
  @@index([websiteId, locale])
  @@map("seo_drafts")
}

model TemplateCatalogEntry {
  id                      String                  @id @db.Uuid
  templateId              String                  @unique @map("template_id") @db.VarChar(160)
  displayName             String                  @map("display_name") @db.VarChar(200)
  author                  String                  @db.VarChar(200)
  description             String                  @db.Text
  category                String                  @db.VarChar(80)
  lifecycleStatus         String                  @map("lifecycle_status") @db.VarChar(24)
  catalogVisible          Boolean                 @default(true) @map("catalog_visible")
  catalogPriceMinor       Int                     @default(25000) @map("catalog_price_minor")
  catalogCurrency         String                  @default("EGP") @map("catalog_currency") @db.VarChar(8)
  catalogBillingPeriod    String                  @default("month") @map("catalog_billing_period") @db.VarChar(24)
  catalogFeatured         Boolean                 @default(false) @map("catalog_featured")
  catalogSortOrder        Int                     @default(0) @map("catalog_sort_order")
  catalogCategory         String?                 @map("catalog_category") @db.VarChar(80)
  catalogCategoryAr       String?                 @map("catalog_category_ar") @db.VarChar(80)
  catalogBadge            String?                 @map("catalog_badge") @db.VarChar(80)
  catalogBadgeAr          String?                 @map("catalog_badge_ar") @db.VarChar(80)
  catalogCtaLabel         String?                 @map("catalog_cta_label") @db.VarChar(80)
  catalogCtaLabelAr       String?                 @map("catalog_cta_label_ar") @db.VarChar(80)
  catalogCtaHref          String?                 @map("catalog_cta_href") @db.Text
  catalogSalesDescription String?                 @map("catalog_sales_description") @db.Text
  catalogSalesDescriptionAr String?               @map("catalog_sales_description_ar") @db.Text
  catalogHighlightsJson   Json                    @default("[]") @map("catalog_highlights_json") @db.JsonB
  catalogHighlightsArJson Json                    @default("[]") @map("catalog_highlights_ar_json") @db.JsonB
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz
